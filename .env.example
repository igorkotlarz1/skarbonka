# Copy to .env (gitignored) and adjust. Read by the backend settings and by docker compose.
SKARBONKA_DATABASE_URL=postgresql+psycopg://skarbonka:skarbonka@localhost:5432/skarbonka
SKARBONKA_TIMEZONE=Europe/Warsaw
SKARBONKA_LOG_LEVEL=INFO
# Classifier (M6): where `skarbonka train` saves the model, and the confidence it needs
# to set a category by itself (below it the guess waits in the review queue).
# SKARBONKA_MODELS_DIR=/absolute/path  (default: models/ at the repo root, gitignored)
SKARBONKA_ML_THRESHOLD=0.8

POSTGRES_USER=skarbonka
POSTGRES_PASSWORD=skarbonka
POSTGRES_DB=skarbonka
POSTGRES_PORT=5432
